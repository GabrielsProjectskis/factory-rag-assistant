# Copy to .env and adjust. Everything here can also be changed in Settings, except PRIVATE_MODE.

# true  = only models on this machine / network may be used. Nothing leaves the building.
# false = cloud APIs (Google) are allowed. Questions, document text and photos are sent to them.
PRIVATE_MODE=true

# --- Local, private setup (default): Gemma 4 through Ollama ---
CHAT_PROVIDER=ollama
CHAT_MODEL=gemma4:e4b
VISION_PROVIDER=ollama
VISION_MODEL=gemma4:12b
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=embeddinggemma
OLLAMA_BASE_URL=http://localhost:11434

# --- Google AI API (needs PRIVATE_MODE=false) ---
# CHAT_PROVIDER=google
# CHAT_MODEL=gemma-4-26b-a4b-it
# VISION_PROVIDER=google
# VISION_MODEL=gemini-4-hydrogen
# EMBEDDING_PROVIDER=google
# EMBEDDING_MODEL=gemini-embedding-2
# GOOGLE_API_KEY=

# --- Any OpenAI-compatible server (LM Studio, vLLM, llama.cpp ...) ---
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_API_KEY=

APP_NAME=Factory Assistant
# Placeholder ICS code format (e.g. 20-PMP-001). Replace once the real format is known.
# ICS_PATTERN=\b\d{2}-[A-Z]{2,4}-\d{3}\b
HOST=127.0.0.1
PORT=8000
